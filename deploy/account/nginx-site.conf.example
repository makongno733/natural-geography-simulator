# Enable this file only after the certificate paths below exist.
# The ACME webroot must be created before requesting an HTTP-01 certificate.
server {
    listen 80;
    server_name account.kongnoma279.com;

    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/account.kongnoma279.com;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name account.kongnoma279.com;

    ssl_certificate /www/server/panel/vhost/cert/geo-account/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/geo-account/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
