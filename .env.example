# Main site and account portal must share the same parent domain in production.
SITE_ORIGIN=https://geo.kongnoma279.com
AUTH_ORIGIN=https://account.kongnoma279.com
VITE_SITE_ORIGIN=https://geo.kongnoma279.com
VITE_ACCOUNT_ORIGIN=https://account.kongnoma279.com

NODE_ENV=production
ACCOUNT_PORT=4100
ACCOUNT_BIND=127.0.0.1
ACCOUNT_DB_PATH=
ACCOUNT_DIST_PATH=
BETTER_AUTH_SECRET=

# Email registration is enabled only when all four settings below are present.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# DeepSeek is called by the account server only. Never use a VITE_ prefix here.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
